# Copy to backend/.env (gitignored) and fill in the values you need.
# Never commit values. The process environment wins over this file.

# OpenRouter (paid models): `ask`, run summaries and the OpenRouter agent backend.
OPENROUTER_API_KEY=

# RunPod control plane (on_demand mode). Stays on the machine that launches
# pods; it is never sent to a pod.
RUNPOD_API_KEY=

# Claude CLI backend. Optional: a directory other than ~/.claude holding the
# CLI login. The CLI uses its own subscription login, not an API key.
CLAUDE_CONFIG_DIR=

# Optional: Hugging Face downloads (datasets, base models); passed to agents.
HF_TOKEN=

# Optional: path of a backend config file other than config/backend.yaml.
CHIPIN_CONFIG=

# Optional: the chip lab outside its default install (README "Chip lab").
# Paths, not secrets. Leave commented out when the lab is in ~/.local/bin.
# CHIPIN_CHIPLAB_BIN=
# CHIPLAB_CONFIG=
# CHIPLAB_USER_DIR=
